# ================================================================
# TrustCV Ethereum Anchor Configuration
# ================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or hardcode private keys.

# Ethereum RPC endpoint
# For local development with Anvil: http://127.0.0.1:8545
# For Sepolia testnet: https://sepolia.infura.io/v3/YOUR_KEY
TRUSTCV_ETH_RPC_URL=http://127.0.0.1:8545

# Private key for signing Ethereum transactions (without 0x prefix)
# For Anvil default account: ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
TRUSTCV_ETH_PRIVATE_KEY=

# Deployed AuditAnchor contract address (set after deployment)
TRUSTCV_ETH_CONTRACT_ADDRESS=

# Chain ID (1=mainnet, 11155111=sepolia, 31337=anvil/hardhat)
TRUSTCV_ETH_CHAIN_ID=31337
