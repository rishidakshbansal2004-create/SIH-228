# ====================================================================
# TrustCV Model Integrity Configuration (.env.example)
# ====================================================================
# Copy this file to .env and configure local-only values.
# NEVER commit private keys or sensitive .env files to GitHub.
#
# Option A: Path to local private key file (kept outside Git or in ignored keys/)
# TRUSTCV_PRIVATE_KEY_PATH=keys/vendor_private_key.pem
#
# Option B: Raw Ed25519 PEM string (kept outside Git)
# TRUSTCV_PRIVATE_KEY="<ed25519-pem-string>"
#
# Path to trusted public key file (safe to commit/distribute)
# TRUSTCV_PUBLIC_KEY_PATH=keys/vendor_public_key.pem
